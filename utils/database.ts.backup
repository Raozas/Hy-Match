          postal_code TEXT,
          prefecture TEXT,
          city1 TEXT,
          city2 TEXT,
          street_address TEXT,
          phone_number TEXT,
          email TEXT,
          profile_image TEXT,
          profile_video TEXT,
          created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
          updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
        );`);b = SQLite.openDatabaseSync('profile.db');

export interface UserProfile {
  id?: number;
  name: string;
  age?: string;
  country?: string;
  homeStation?: string;
  timeToStationFromHome?: string;
  schoolStation?: string;
  timeToStationFromSchool?: string;
  postalCode?: string;
  prefecture?: string;
  city1?: string;
  city2?: string;
  streetAddress?: string;
  phoneNumber?: string;
  email?: string;
  profileImage?: string;
  profileVideo?: string;
  createdAt?: string;
  updatedAt?: string;
}

class DatabaseService {
  constructor() {
    this.initDatabase();
  }

  private initDatabase() {
    try {
      // Create the table with ALL columns from the start
      db.execSync(
        `CREATE TABLE IF NOT EXISTS user_profiles (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          name TEXT NOT NULL,
          age TEXT,
          country TEXT,
          home_station TEXT,
          time_to_station_from_home TEXT,
          school_station TEXT,
          time_to_station_from_school TEXT,
          profile_image TEXT,
          profile_video TEXT,
          created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
          updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
        );`
      );

      // Add missing columns for existing databases (backwards compatibility)
      const addColumnIfNotExists = (columnName: string, columnType: string) => {
        try {
          const columns = db.getAllSync(`PRAGMA table_info(user_profiles);`);
          const hasColumn = columns.some((col: any) => col.name === columnName);
          
          if (!hasColumn) {
            console.log(`Adding ${columnName} column to database`);
            db.execSync(`ALTER TABLE user_profiles ADD COLUMN ${columnName} ${columnType};`);
            console.log(`Successfully added ${columnName} column`);
          }
        } catch (error) {
          console.error(`Error adding ${columnName} column:`, error);
        }
      };

      // Only add columns that might be missing from older versions
      addColumnIfNotExists('profile_video', 'TEXT');
      addColumnIfNotExists('age', 'TEXT');
      addColumnIfNotExists('country', 'TEXT');
      addColumnIfNotExists('home_station', 'TEXT');
      addColumnIfNotExists('time_to_station_from_home', 'TEXT');
      addColumnIfNotExists('school_station', 'TEXT');
      addColumnIfNotExists('time_to_station_from_school', 'TEXT');
      
      console.log('Database initialization complete');
      
    } catch (error) {
      console.error('Error initializing database:', error);
      throw error;
    }
  }

  async saveUserProfile(profile: UserProfile): Promise<number> {
    try {
      const result = await db.runAsync(
        `INSERT OR REPLACE INTO user_profiles 
         (name, age, country, home_station, time_to_station_from_home, school_station, time_to_station_from_school, profile_image, profile_video, updated_at) 
         VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP)`,
        [
          profile.name, 
          profile.age || '', 
          profile.country || '', 
          profile.homeStation || '', 
          profile.timeToStationFromHome || '',
          profile.schoolStation || '',
          profile.timeToStationFromSchool || '',
          profile.profileImage || '', 
          profile.profileVideo || ''
        ]
      );
      return result.lastInsertRowId;
    } catch (error) {
      console.error('Error saving user profile:', error);
      throw error;
    }
  }

  async getUserProfile(): Promise<UserProfile | null> {
    try {
      const result = await db.getFirstAsync<any>(
        `SELECT * FROM user_profiles ORDER BY updated_at DESC LIMIT 1`
      );
      
      if (result) {
        return {
          id: result.id,
          name: result.name,
          age: result.age || undefined,
          country: result.country || undefined,
          homeStation: result.home_station || undefined,
          timeToStationFromHome: result.time_to_station_from_home || undefined,
          schoolStation: result.school_station || undefined,
          timeToStationFromSchool: result.time_to_station_from_school || undefined,
          profileImage: result.profile_image || undefined,
          profileVideo: result.profile_video || undefined,
          createdAt: result.created_at,
          updatedAt: result.updated_at,
        };
      }
      return null;
    } catch (error) {
      console.error('Error getting user profile, attempting database reset:', error);
      // Force recreate database with all columns
      await this.resetDatabase();
      return null;
    }
  }

  async updateProfileImage(imageUri: string): Promise<boolean> {
    try {
      const result = await db.runAsync(
        `UPDATE user_profiles SET profile_image = ?, updated_at = CURRENT_TIMESTAMP 
         WHERE id = (SELECT id FROM user_profiles ORDER BY updated_at DESC LIMIT 1)`,
        [imageUri]
      );
      return result.changes > 0;
    } catch (error) {
      console.error('Error updating profile image:', error);
      throw error;
    }
  }

  async updateProfileVideo(videoUri: string): Promise<boolean> {
    try {
      const result = await db.runAsync(
        `UPDATE user_profiles SET profile_video = ?, updated_at = CURRENT_TIMESTAMP 
         WHERE id = (SELECT id FROM user_profiles ORDER BY updated_at DESC LIMIT 1)`,
        [videoUri]
      );
      return result.changes > 0;
    } catch (error) {
      console.error('Error updating profile video:', error);
      throw error;
    }
  }

  // Method to reset database for testing/debugging
  async resetDatabase(): Promise<void> {
    try {
      console.log('Resetting database...');
      db.execSync('DROP TABLE IF EXISTS user_profiles;');
      console.log('Dropped existing table');
      this.initDatabase();
      console.log('Database reset complete - new table created with all columns');
    } catch (error) {
      console.error('Error resetting database:', error);
      throw error;
    }
  }

  // Method to check database health
  async checkDatabaseHealth(): Promise<boolean> {
    try {
      const columns = db.getAllSync(`PRAGMA table_info(user_profiles);`);
      console.log('Database health check - columns:', columns);
      
      // Test a simple query
      const testResult = await db.getFirstAsync('SELECT COUNT(*) as count FROM user_profiles');
      console.log('Database health check - query test:', testResult);
      
      return true;
    } catch (error) {
      console.error('Database health check failed:', error);
      return false;
    }
  }
}

export const databaseService = new DatabaseService();
