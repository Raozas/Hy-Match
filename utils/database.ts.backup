import * as SQLite from 'expo-sql      // Create the table with ALL columns from the start
      db.execSync(
        `CREATE TABLE IF NOT EXISTS user_profiles (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          name TEXT NOT NULL,
          age TEXT,
          country TEXT,
          home_station TEXT,
          time_to_station_from_home TEXT,
          school_station TEXT,
